# Somente desenvolvimento local; copie para .env e substitua os segredos.
DJANGO_SECRET_KEY=replace-with-random-local-secret
DJANGO_DEBUG=1
# Defina 0 para iniciar sem criar dados de demonstracao.
DJANGO_SEED_DEMO=1
DJANGO_ALLOWED_HOSTS=*
# Em producao (DJANGO_DEBUG=0), hosts explicitos sao obrigatorios; * e rejeitado.
# HTTPS e cookies Secure sao obrigatorios em producao. O backend deve ser
# acessivel apenas pelos proxies confiaveis; use 0 se servir sem proxy.
DJANGO_TRUST_PROXY_SSL_HEADER=1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
POSTGRES_DB=encontro
POSTGRES_USER=encontro
POSTGRES_PASSWORD=replace-with-random-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
DJANGO_CACHE_URL=redis://redis:6379/2
DJANGO_CACHE_KEY_PREFIX=eventconnect
# Compose usa Nginx para entregar a midia apos a autorizacao Django.
# Use 0 somente ao servir Django diretamente sem o proxy Nginx.
MEDIA_USE_X_ACCEL_REDIRECT=1
# Opcional: por padrao, usa <DJANGO_CACHE_KEY_PREFIX>:channels.
# CHANNEL_REDIS_PREFIX=eventconnect:channels
# Cadeia de proxies confiaveis: Traefik -> Nginx. Use 0 para acesso direto.
DRF_NUM_PROXIES=2
DRF_THROTTLE_ANON=60/min
DRF_THROTTLE_USER=300/min
DRF_THROTTLE_LOGIN=10/min
DRF_THROTTLE_REGISTER=5/min
DRF_THROTTLE_MESSAGES=30/min
DRF_THROTTLE_INTERACTIONS=60/min
DRF_THROTTLE_REPORTS=10/min
HTTP_PORT=8080
# Publica o HTTP em todas as interfaces IPv4 do host.
HTTP_BIND_ADDRESS=0.0.0.0

# mock: telas com dados fictícios; django: backend real, sem fallback para mocks.
# Independente de DJANGO_DEBUG. Recrie o frontend ao alterar este valor.
FRONTEND_DATA_MODE=mock

# Contas de demonstração criadas uma única vez, exclusivamente com DJANGO_DEBUG=1.
DEMO_USER_EMAIL=demo@eventconnect.local
DEMO_USER_PASSWORD=replace-with-random-demo-password

# Participants per initial gift task (1-100); processed by celery_gifts.
INITIAL_GIFT_BATCH_SIZE=25
DJANGO_ADMIN_LOGIN_IP_LIMIT=5
DJANGO_ADMIN_LOGIN_ACCOUNT_LIMIT=10
DJANGO_ADMIN_LOGIN_WINDOW_SECONDS=300
