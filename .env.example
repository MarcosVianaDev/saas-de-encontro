# Somente desenvolvimento local; copie para .env e substitua os segredos.
DJANGO_SECRET_KEY=replace-with-random-local-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
POSTGRES_DB=encontro
POSTGRES_USER=encontro
POSTGRES_PASSWORD=replace-with-random-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
HTTP_PORT=8080

# mock: telas com dados fictícios; debug: backend real, sem fallback para mocks.
# Independente de DJANGO_DEBUG. Recrie o frontend ao alterar este valor.
FRONTEND_DATA_MODE=mock

# Contas de demonstração criadas uma única vez, exclusivamente com DJANGO_DEBUG=1.
DEMO_USER_EMAIL=demo@eventconnect.local
DEMO_USER_PASSWORD=replace-with-random-demo-password
