# Copie para .env.prod e substitua dominio, email e segredos antes de iniciar.
# docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build --wait
APP_DOMAIN=encontro.example.com
ACME_EMAIL=admin@example.com
APP_VERSION=local
PROD_DATA_DIR=./data/production
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
POSTGRES_DB=encontro
POSTGRES_USER=encontro
POSTGRES_PASSWORD=replace-with-a-strong-production-database-password
POSTGRES_PORT=5432
# DEBUG=0, seed=0, hosts, HTTPS, proxies e modo django sao fixados pelo Compose.
DRF_THROTTLE_ANON=60/min
DRF_THROTTLE_USER=300/min
DRF_THROTTLE_LOGIN=10/min
DRF_THROTTLE_REGISTER=5/min
DRF_THROTTLE_MESSAGES=30/min
DRF_THROTTLE_INTERACTIONS=60/min
DRF_THROTTLE_REPORTS=10/min

# Participants per initial gift task (1-100); processed by celery_gifts.
INITIAL_GIFT_BATCH_SIZE=25
